<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sensei.governed-scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>sensei</string>
        <string>scheduler-run-once</string>
        <string>--journal</string>
        <string>/Users/sivasaithota/Documents/trade/data/operations.sqlite3</string>
        <string>--config</string>
        <string>/Users/sivasaithota/Documents/trade/config/scheduler.json</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sivasaithota/Documents/trade</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Asia/Kolkata</string>
    </dict>

    <!-- launchd supplies wakeups; the application owns the NSE date and
         session-window decision and journals a deterministic task identity. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <!-- launchd hands its children only 256 descriptors (launchctl limit
         maxfiles). The market-data refresh opens hundreds of concurrent
         connections, exhausted that budget, and then sqlite could not open the
         operations journal - the desk died mid-cycle without a terminal event,
         silently dropping already-approved theses. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/sivasaithota/Documents/trade/data/logs/governed-scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sivasaithota/Documents/trade/data/logs/governed-scheduler.err</string>
</dict>
</plist>
